MONGODB_URI=mongodb://127.0.0.1:27017/tourgenie
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Behind a proxy (Vercel, Render, nginx) set this to the number of proxies in
# front of the API, usually 1, so sign-in rate limiting sees the visitor's
# address instead of the proxy's. Leave empty when running locally.
TRUST_PROXY=

# --- Outgoing email (password reset codes) -------------------------------
# MAIL_PASS must be a Google App Password (16 chars, no spaces), created at
# https://myaccount.google.com/apppasswords with 2-Step Verification on.
#
# Leave MAIL_USER / MAIL_PASS blank and nothing is sent: the server logs the
# email instead and, outside production, the API hands the code back in the
# response so the reset flow still works in development.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
